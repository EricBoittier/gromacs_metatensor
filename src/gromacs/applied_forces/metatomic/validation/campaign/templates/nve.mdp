; NVE with ONIOM, 20 ps
integrator              = md
dt                      = 0.0005
nsteps                  = 40000
constraints             = none
cutoff-scheme           = Verlet
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
; PET-MAD interaction range is 1.5 nm: fixed pairlist reaching past it
verlet-buffer-tolerance = -1
rlist                   = 1.55
nstlist                 = 20
tcoupl                  = no
pcoupl                  = no
continuation            = yes
nstcalcenergy           = 1
nstenergy               = 20
nstlog                  = 2000
nstxout-compressed      = 1000
nstvout                 = 0
; ONIOM: E = E_MM(full) + E_PET-MAD(peptide) - E_MM(peptide)
metatomic-active        = yes
metatomic-model         = /home/boittier/metawork/openmm-metatomic/models/pet-mad-xs-v1.5.0.pt
metatomic-input-group   = ML
metatomic-device        = cuda
metatomic-oniom         = yes
